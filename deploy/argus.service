[Unit]
Description=ARGUS wearable assistant
After=default.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ -m argus.service
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
KillMode=mixed
StandardOutput=append:/opt/argus/logs/runtime.log
StandardError=append:/opt/argus/logs/runtime.log

[Install]
WantedBy=default.target
